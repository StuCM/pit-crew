{
  "name": "@stucm/pit-crew",
  "version": "0.1.0",
  "description": "A task loop for coding agents: an approved spec, a worker in its own worktree, a deterministic gate, and an independent review that cannot edit.",
  "keywords": [
    "claude-code",
    "agents",
    "git-hooks",
    "commit-convention",
    "code-review"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StuCM/pit-crew.git"
  },
  "bugs": {
    "url": "https://github.com/StuCM/pit-crew/issues"
  },
  "homepage": "https://github.com/StuCM/pit-crew#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "crew": "src/cli.js"
  },
  "exports": {
    ".": "./src/lib/index.js",
    "./schema": "./schema/crew.config.schema.json"
  },
  "files": [
    "src",
    "schema",
    "planning/scripts",
    "templates",
    "githooks",
    ".claude-plugin",
    "skills",
    "agents",
    "hooks",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "version": "node scripts/version.js && git add .claude-plugin planning/.claude-plugin",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "verify": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "oxfmt": "^0.70.0"
  }
}
