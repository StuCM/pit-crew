{
  "plugins": [
    "unicorn",
    "import",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "node_modules",
    "planning/**"
  ],
  "overrides": [
    {
      "files": ["hooks/tests/*.test.ts"],
      "rules": { "no-await-in-loop": "off" }
    }
  ],
  "rules": {
    "no-console": "off",
    "unicorn/no-array-sort": "off"
  }
}
